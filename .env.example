# Copy to .env and fill in what you want to use. Everything is optional:
# with nothing set, Keel runs with manual entry, CSV import and the built-in monitor.

# --- Assistant (Claude) -------------------------------------------------------
# Enables the chat assistant and AI-written briefings. https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Bank linking (Plaid) -----------------------------------------------------
# https://dashboard.plaid.com → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake banks, free) or production (real banks)
PLAID_ENV=sandbox
# Only needed for OAuth banks in production; must be HTTPS and registered in the Plaid dashboard.
# PLAID_REDIRECT_URI=

# --- Access -------------------------------------------------------------------
# Keel listens on this machine only by default. To open it from your phone, set
# HOST=0.0.0.0 AND a password (Keel refuses to start on the network without one).
# HOST=0.0.0.0
# PORT=8787
# APP_PASSWORD=

# Encrypts stored Plaid access tokens at rest (any long random string).
# DATA_ENCRYPTION_KEY=

# Optional: live stock quotes via Finnhub instead of the keyless default.
# FINNHUB_API_KEY=
